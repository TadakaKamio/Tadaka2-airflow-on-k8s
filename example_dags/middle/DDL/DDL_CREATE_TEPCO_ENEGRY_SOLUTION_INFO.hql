CREATE TABLE IF NOT EXISTS db_middle.TEPCO_ENEGRY_SOLUTION_INFO (
    BANK_CODE VARCHAR(4),
    CORPORATE_NUMBER VARCHAR(13),
    AREA_ID STRING,
    BUILDING_NAME STRING,
    BUILDING_ID STRING,
    SUB_BUILDING_NAME STRING,
    FISCAL_YEAR VARCHAR(4),
    ELECTRIC_USAGE_TARIFFS DECIMAL(10,2),
    CITY_GAS_RATES_SUMMER DECIMAL(10,2),
    CITY_GAS_RATES_OTHER_SEASONS DECIMAL(10,2),
    CITY_GAS_RATES_WEIGHTED_AVERAGE DECIMAL(10,2),
    CITY_GAS_RATES_FIFTY DECIMAL(10,2),
    CITY_GAS_RATES_ONE DECIMAL(10,2),
    EMISSION_COEFFICIENT_POWER DECIMAL(10,8),
    EMISSION_COEFFICIENT_GAS DECIMAL(10,8),
    EMISSION_COEFFICIENT_LPG DECIMAL(10,8),
    SOLUTION_CODE VARCHAR(2),
    SOLUTION_NAME VARCHAR(20),
    RENDERABLE_RATIO DECIMAL(3,2),
    LED_PRICE DECIMAL(8,0),
    LED_INSTALLATION_PRICE DECIMAL(10,0),
    LED_ANNUAL_POWER_CONSUMPTION DECIMAL(10,0),
    LED_RATED_POWER_CONSUMPTION DECIMAL(10,1),
    LED_RATED_LIFETIME DECIMAL(8,0),
    LEGAL_SERVICE_LIFE DECIMAL(10,0),
    PRACTICAL_SERVICE_LIFE DECIMAL(10,1),
    FLUORESCENT_LAMP_PRICE DECIMAL(10,0),
    ANNUAL_POWER_CONSUMPTION DECIMAL(10,0),
    FLUORESCENT_LAMP_ANNUAL_POWER_CONSUMPTION DECIMAL(10,0),
    FLUORESCENT_LAMP_LIFETIME DECIMAL(8,0),
    REQUIRED_LIGHT DECIMAL(10,2),
    FLUORESCENT_LAMP_REPLACEMENT_FREQUENCY DECIMAL(10,1),
    SUBSIDIE DECIMAL(8,0),
    ADJUSTMENT_VARIABLE DECIMAL(10,0),
    PV_USABLE_AREA_RATIO DECIMAL(3,2),
    AREA_TO_POWER_CONVERSION DECIMAL(10,2),
    ANNUAL_GENERATION_PER_CAPACITY DECIMAL(10,0),
    SELF_CONSUMPTION_RATE DECIMAL(3,2),
    PV_UNIT_PRICE DECIMAL(8,0),
    PV_MOUNTING_INSTALLATION_COST DECIMAL(8,0),
    PV_OM_COST_PER_UNIT DECIMAL(8,0),
    EQUIPMENT_UNIT_PRICE DECIMAL(8,0),
    CONSTRUCTION_UNIT_PRICE DECIMAL(8,0),
    YEAR_CREATION STRING,
    HEAT_LOAD_BASIS_UNIT DECIMAL(10,1),
    INDIVIDUAL_EQUIPMENT_COST DECIMAL(8,0),
    CENTRAL_EQUIPMENT_COST DECIMAL(8,0),
    INDIVIDUAL_EQUIPMENT_COST_AREA DECIMAL(8,0),
    CENTRAL_EQUIPMENT_COST_AREA DECIMAL(8,0),
    RATE_OF_DETERIORATION_OVER_TIME DECIMAL(5,4),
    COOLING_LOAD_RUNTIME DECIMAL(10,0),
    HEATING_LOAD_RUNTIME DECIMAL(10,0),
    HOT_WATER_GAS_TYPE_SUPPLY VARCHAR(1),
    GAS_UNIT_PRICE DECIMAL(10,2),
    ECO_CUTE_EXPENSES DECIMAL(8,0),
    MODEL_EQUIPMENT_CAPACITY_INTERIM DECIMAL(10,1),
    MODEL_EQUIPMENT_CAPACITY_WINTER DECIMAL(10,1),
    ENERGY_EFFICIENCY DECIMAL(10,2),
    CITY_GAS_HIGH_CALORIFIC DECIMAL(10,1),
    LPG_GAS_HIGH_CALORIFIC DECIMAL(10,1),
    CITY_GAS_LOW_CALORIFIC DECIMAL(10,1),
    LPG_GAS_LOW_CALORIFIC DECIMAL(10,1),
    OPERATING_DAYS_SEASON DECIMAL(10,0),
    OPERATING_DAYS_OTHER DECIMAL(10,0),
    HOT_WATER_TEMPERTURE DECIMAL(10,1),
    WATER_SUPPLY_TEMPERTURE_SEASON DECIMAL(10,1),
    WATER_SUPPLY_TEMPERTURE_OTHER DECIMAL(10,1),
