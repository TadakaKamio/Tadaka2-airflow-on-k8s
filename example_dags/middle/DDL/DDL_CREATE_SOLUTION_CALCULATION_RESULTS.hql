CREATE TABLE IF NOT EXISTS db_middle.SOLUTION_CALCULATION_RESULTS (
    BANK_CODE VARCHAR(4),
    CORPORATE_NUMBER VARCHAR(13),
    AREA_ID STRING,
    BUILDING_NAME STRING,
    BUILDING_ID STRING,
    SUB_BUILDING_NAME STRING,
    FISCAL_YEAR VARCHAR(4),
    SOLUTION_CODE VARCHAR(2),
    SOLUTION_NAME VARCHAR(20),
    CONVENTIONAL_FLUORESCENT_LAMP_QUANTITY DOUBLE,
    LED_ANNUAL_POWER_CONSUMPTION DOUBLE,
    FLUORESCENT_LAMP_ANNUAL_POWER_CONSUMPTION DOUBLE,
    LED_ANNUAL_POWER_REDUCTION DOUBLE,
    EQUIPMENT_COST DOUBLE,
    CONSTRUCTION_COST DOUBLE,
    IMPLEMENTATION_COST DOUBLE,
    ANNUAL_EQUIPMENT_REPLACEMENT_COST DOUBLE,
    PV_INSTALLABLE_AREA DOUBLE,
    PV_CAPACITY DOUBLE,
    PV_ANNUAL_GENERATION DOUBLE,
    PV_TOTAL_GENERATION DOUBLE,
    PV_OM_ANNUAL_COST DOUBLE,
    CONVENTIONAL_RUNNING_COST DOUBLE,
    AIR_CONDITIONING_LOAD DOUBLE,
    EQUIPMENT_CAPACITY DOUBLE,
    COOLING_HIGH_AIRCON_ANNUAL_POWER_USAGE DOUBLE,
    HEATING_HIGH_AIRCON_ANNUAL_POWER_USAGE DOUBLE,
    TOTAL_HIGH_AIRCON_ANNUAL_POWER_USAGE DOUBLE,
    COOLING_CONVENTIONAL_AIRCON_ANNUAL_POWER_USAGE DOUBLE,
    HEATING_CONVENTIONAL_AIRCON_ANNUAL_POWER_USAGE DOUBLE,
    TOTAL_CONVENTIONAL_AIRCON_ANNUAL_POWER_USAGE DOUBLE,
    GAS_USAGE_REFUELING_OTHER DOUBLE,
    GAS_USAGE_REFUELING DOUBLE,
    HOT_WATER_HEAT_LOAD_SEASON DOUBLE,
    DAY_HOT_WATER_HEAT_LOAD_SEASON DOUBLE,
    EHP_REQUIRED_HEATING_CAPACITY_SEASON DOUBLE,
    INSTALLED_EQUIPMENT_CAPACITY DOUBLE,
    DAY_HOT_WATER_VOLUME_SEASON DOUBLE,
    TIME_AVERAGE_HOT_WATER_VOLUME_SEASON DOUBLE,
    PEAK_HOT_WATER_VOLUME_SEASON DOUBLE,
    POWER_CONSUMPTION_SEASON DOUBLE,
    HOT_WATER_HEAT_LOAD_OTHER DOUBLE,
    DAY_HOT_WATER_HEAT_LOAD_OTHER DOUBLE,
    EHP_REQUIRED_HEATING_CAPACITY_OTHER DOUBLE,
    DAY_HOT_WATER_VOLUME_OTHER DOUBLE,
    TIME_AVERAGE_HOT_WATER_VOLUME_OTHER DOUBLE,
    PEAK_HOT_WATER_VOLUME_OTHER DOUBLE,
    POWER_CONSUMPTION_SEASON_OTHER DOUBLE,
    EHP_POWER_CONSUMPTION DOUBLE,
    REQUIRED_ECO_CUTE_QUANTITY DOUBLE,
    ANNUAL_COST_SAVINGS_ECOCUTE_GAS_REDUCTION DOUBLE,
    ANNUAL_POWER_INCREASE_ECOCUTE_INSTALLATION DOUBLE,
    REDUCE_THE_TOTAL_CO2_EMISSIONS DOUBLE,
    CREATION_DATETIME TIMESTAMP,
    CREATOR STRING
)
PARTITIONED BY (
    PART_BANK_CODE VARCHAR(4),
    PART_CORPORATE_NUMBER VARCHAR(13),
    PART_BUILDING_ID STRING,
    PART_FISCAL_YEAR VARCHAR(4)
)
STORED AS PARQUET
LOCATION '/hd/hd-volume-01/middle/SOLUTION_CALCULATION_RESULTS';
