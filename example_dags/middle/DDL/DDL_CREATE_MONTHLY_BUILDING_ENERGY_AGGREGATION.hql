CREATE TABLE IF NOT EXISTS db_middle.MONTHLY_BUILDING_ENERGY_AGGREGATION (
    CORPORATE_NUMBER VARCHAR(13),
    BANK_CODE VARCHAR(4),
    AREA_ID STRING,
    AREA_INFORMATION STRING,
    BUILDING_ID STRING,
    BUILDING_NAME VARCHAR(50),
    ENERGY_CODE VARCHAR(20),
    ENERGY_NAME VARCHAR(20),
    ENERGY_CATEGORY VARCHAR(20),
    FISCAL_YEAR VARCHAR(4),
    YEAR VARCHAR(4),
    MONTH VARCHAR(2),
    ENERGY_UNITS VARCHAR(5),
    ENERGY_CONSUMPTION DECIMAL(12,2),
    CALORIFIC_ENERGY_CONSUMPTION DECIMAL(12,2),
    CALORIFIC_ENERGY_CONSUMPTION_UNIT DECIMAL(8,4),
    CO2_EMISSIONS_AREA_UNIT DECIMAL(8,4),
    CO2_EMISSIONS DECIMAL(12,2),
    CRUDE_OIL_ENERGY_CONSUMPTION_UNIT DECIMAL(8,4),
    CRUDE_OIL_ENERGY_CONSUMPTION DECIMAL(12,2),
    ELECTRIC_CONSUMPTION_UNIT DECIMAL(8,4),
    TARGET_YEAR VARCHAR(4),
    BUILDING_USAGE STRING,
    QUADRANT STRING,
    SCATTER_PLOT_LABEL STRING,
    PRIMARY_ENERGY_CONSUMPTION_E STRING,
    PRIMARY_ENERGY_CONSUMPTION_GAS STRING,
    PRIMARY_ENERGY_CONSUMPTION_OTHER STRING,
    PRIMARY_ENERGY_CONSUMPTION STRING,
    PRIMARY_ENERGY_EQUIVALENT STRING,
    ENERGY_CONSUMPTION_DUE_RENOVATION_E STRING,
    REDUCTION_AMOUNT_DUE_RENOVATION_E STRING,
    REDUCTION_AMOUNT_DUE_ENERGY_EFFORTS_GOAL_E STRING,
    REDUCTION_AMOUNT_DUE_POWER_GENERATION_E STRING,
    TRANSFER_REMOVAL_SALE_E STRING,
    ACTUAL_PERFORMANCE_E STRING,
    CO2_EMISSIONS_C STRING,
    REDUCTION_AMOUNT_DUE_RENOVATION_C STRING,
    REDUCTION_AMOUNT_DUE_ENERGY_EFFORTS_GOAL_C STRING,
    REDUCTION_AMOUNT_DUE_POWER_GENERATION_C STRING,
    REDUCTION_AMOUNT_DUE_ELECTRIFICATION STRING,
    TRANSFER_REMOVAL_SALE_C STRING,
    REDUCTION_EFFECT_SUPPLY_SIDE STRING,
    REDUCTION_EFFECT_DUE_CERTIFICATE_PURCHASE STRING,
    ACTUAL_PERFORMANCE_C STRING,
    CREATION_DATETIME TIMESTAMP,
    CREATOR VARCHAR(50)
)
PARTITIONED BY (
    PART_BANK_CODE VARCHAR(4),
    PART_CORPORATE_NUMBER VARCHAR(13), 
    PART_BUILDING_ID STRING,
    PART_FISCAL_YEAR VARCHAR(4)
)
STORED AS PARQUET 
LOCATION '/hd/hd-volume-01/middle/MONTHLY_BUILDING_ENERGY_AGGREGATION';
