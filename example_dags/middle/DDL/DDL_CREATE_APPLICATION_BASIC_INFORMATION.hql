CREATE TABLE IF NOT EXISTS db_middle.APPLICATION_BASIC_INFORMATION (
    BANK_CODE VARCHAR(4),
    BANK_NAME VARCHAR(100),
    BRANCH_CODE VARCHAR(3),
    CORPORATE_NUMBER VARCHAR(13),
    DEPARTMENT_BRANCH_NAME VARCHAR(100),
    CONTACT_PERSON_NAME_LOCAL_BANK VARCHAR(30),
    PHONE_NUMBER_LOCAL_BANK VARCHAR(10),
    EMAIL_ADDRESS_LOCAL_BANK VARCHAR(30),
    CONTACT_PERSON_NAME_CORPORATE VARCHAR(30),
    PHONE_NUMBER_CORPORATE VARCHAR(10),
    UTILIZATION_APPROVAL_DATE_CORPORATE DATE,
    CORPORATE_NAME VARCHAR(100),
    OFFICE_ADDRESS VARCHAR(400),
    NUMBER_OFFICES INT,
    INDUSTRY_BROAD_CATEGORIZATION VARCHAR(2),
    INDUSTRY_BROAD_CATEGORIZATION_NAME STRING,
    INDUSTRY_INTERMEDIATE_CLASSIFICATION VARCHAR(3),
    INDUSTRY_INTERMEDIATE_CLASSIFICATION_NAME STRING,
    FISCAL_YEAR VARCHAR(4),
    START_PERIOD VARCHAR(4),
    END_PERIOD VARCHAR(4),
    AREA_ID VARCHAR(16),
    AREA_INFORMATION STRING,
    BUILDING_ID STRING,
    BUILDING_NAME VARCHAR(50),
    INDUSTRY_CATEGORY_SMALL_CODE VARCHAR(6),
    INDUSTRY_CATEGORY_SMALL VARCHAR(100),
    SUPPLY_POINT_NUMBER VARCHAR(27),
    EP_STORE_NUMBER VARCHAR(3),
    CUSTOMER_NUMBER_EP VARCHAR(16),
    BUILDING_COMPLETION_YEAR VARCHAR(4),
    EARTHQUAKE_RESISTANCE_STANDARDS VARCHAR(1),
    ADDRESS VARCHAR(400),
    GROSS_FLOOR_AREA DECIMAL(8,2),
    REGISTRATION_NUMBER STRING,
    ELECTRIC_POWER_CORPORATE_NAME VARCHAR(50),
    CONTRACTED_POWER DECIMAL(10,3),
    ELECTRICITY_USAGE_FEE_SUMMER DECIMAL(6,2),
    ELECTRICITY_USAGE_FEE_OTHER_SEASONS DECIMAL(6,2),
    FUEL_COST_ADJUSTMENT DECIMAL(6,2),
    RENEWABLE_ENERGY_SURCHARGE DECIMAL(6,2),
    EMPLOYEES INT,
    ANNUAL_WORKING_DAYS INT,
    WORKING_HOURS_ONE_DAY DECIMAL(4,2),
    GAS_WATER_HEATING VARCHAR(1),
    GAS_PRODUCTION_USE VARCHAR(1),
    GAS_AIR_CONDITIONING_USE VARCHAR(1),
    POWER_GENERATION_FACILITIES VARCHAR(1),
    RENEWABLE_ENERGY_POWER VARCHAR(1),
    ENVIRONMENTAL_CERTIFICATE VARCHAR(1),
    ROOF_AREA DECIMAL(8,2),
    PARKING_AREA DECIMAL(8,2),
    AIR_CONDITIONING_SYSTEM VARCHAR(1),
    NEED_AIR_CONDITIONING_REPLACEMENT VARCHAR(1),
    YEAR_AIR_CONDITIONING_REPLACEMENT VARCHAR(4),
    FLUORESCENT_LIGHTS_PERCENTAGE DECIMAL(5,4),
    LED_LIGHTS_PERCENTAGE DECIMAL(5,4),
    BASE_YEAR VARCHAR(4),
    HEAT_SOURCE_LIGHTING_RENEWAL_CYCLE DECIMAL(4),
    OTHER_MEASURES_CYCLE DECIMAL(4),
    CONSIDERATION_OF_MEASURES VARCHAR(1),
    ENERGY_SAVING_TARGET DECIMAL(5,4),
    ELECTRICITY_CO2_EMISSIONS_COEFFICIENT_PATTERN VARCHAR(1),
    BASE_YEAR_FOR_CERTIFICATE_PURCHASE_TO_2030 DECIMAL(5,4),
    CERTIFICATE_PURCHASE_FROM_2030_TO_2050 DECIMAL(5,4),
    SOLAR_INTRODUCTION_YEAR VARCHAR(4),
    ALTERNATIVE_FOR_NON_CONSTRUCTION_YEAR_INDICATION DECIMAL(5),
    CENTRAL_INDIVIDUAL_JUDGMENT DECIMAL(12,2),
    SOLAR_POWER_INSTALLATION_POSSIBLE_RATE DECIMAL(5,4),
    NEW_SEISMIC_ZONING_YEARS DECIMAL(5),
    SOLAR_POWER_GENERATION DECIMAL(12,2),
    SOLAR_POWER_GENERATION_AMOUNT DECIMAL(12,2),
    BUILDING_USAGE INT,
    CREATION_DATETIME TIMESTAMP,
    CREATOR VARCHAR(50)
)
PARTITIONED BY (
    PART_BANK_CODE VARCHAR(4),
    PART_CORPORATE_NUMBER VARCHAR(13),
    PART_BUILDING_ID STRING,
    PART_FISCAL_YEAR VARCHAR(4)
)
STORED AS PARQUET
LOCATION '/hd/hd-volume-01/middle/APPLICATION_BASIC_INFORMATION';
